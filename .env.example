# Copy this file to .env and adjust values for your environment.
# Only set what you need; most values have sensible defaults.
# Tip: `expose server init` can generate .env interactively.

# Server
EXPOSE_DOMAIN=example.com
# Optional override (default: ./expose.db)
# EXPOSE_DB_PATH=./expose.db
# Optional override (default: ./cert)
# EXPOSE_CERT_CACHE_DIR=./cert
# TLS mode: auto|dynamic|wildcard (default: auto)
# EXPOSE_TLS_MODE=auto
# Internal server ports (defaults shown):
# EXPOSE_LISTEN_HTTPS=:10443
# EXPOSE_LISTEN_HTTP_CHALLENGE=:10080
# Optional explicit pepper. If unset, the server generates and persists one automatically.
# EXPOSE_API_KEY_PEPPER=
# Optional explicit secret for signing protected-route access cookies.
# If unset, a random one is generated and persisted in the database.
# EXPOSE_ACCESS_COOKIE_SECRET=
# Max new ACME certificate issuances per hour (default: 10, 0 disables)
# EXPOSE_ACME_ISSUE_RATE_PER_HOUR=10
# Comma-separated trusted proxy/CDN CIDRs. When the peer is trusted,
# the client IP is resolved from X-Forwarded-For (default: empty = trust RemoteAddr only)
# EXPOSE_TRUSTED_PROXY_CIDRS=
# Wildcard mode cert paths (optional if files are placed in EXPOSE_CERT_CACHE_DIR/wildcard.crt|wildcard.key)
# EXPOSE_TLS_CERT_FILE=
# EXPOSE_TLS_KEY_FILE=
# EXPOSE_LOG_LEVEL=info
# WAF structural limits (effective defaults shown; 0 also selects these defaults)
# EXPOSE_WAF_MAX_URI_LENGTH=8192
# EXPOSE_WAF_MAX_HEADER_COUNT=64

# Client
# Local service port to expose (required for `make run-client`)
# EXPOSE_PORT=
# Optional tunnel name/subdomain (used by `expose http --domain` and `make run-client`)
# EXPOSE_SUBDOMAIN=
# Convenience values for `make client-login` / `expose login`
# EXPOSE_DOMAIN=example.com
# EXPOSE_API_KEY=
